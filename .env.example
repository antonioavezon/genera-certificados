# Copie este archivo a .env y complete solo los valores que vaya a usar.
# No guarde contraseñas en el código ni en el repositorio.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DIPLOMAS_PORT=8765
TIME_ZONE=America/Santiago

# none | smtp | outlook
# La elección activa también se guarda en la pantalla Configurar.
EMAIL_PROVIDER=none

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TIMEOUT=30

# Reintentos automáticos dentro de una misma acción de envío.
# El botón Reintentar fallidos es una acción nueva y explícita.
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=1
